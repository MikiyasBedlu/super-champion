# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=production

# Postgres. With docker compose the host is "db"; on a plain VPS it is usually localhost.
DATABASE_URL=postgres://superchampion:CHANGE_ME@localhost:5432/superchampion
DB_PASSWORD=CHANGE_ME
# Set to 1 for hosted Postgres that requires TLS (Neon, Supabase)
DATABASE_SSL=0

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Behind Nginx, Cloudflare or a load balancer
TRUST_PROXY=1
SITE_URL=https://superchampion.et

# First organiser account — created on first start only if no admin exists yet.
# Delete ADMIN_PASSWORD once the account is created.
ADMIN_EMAIL=mikiyasbedlu3@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Mikiyas Bedilu
